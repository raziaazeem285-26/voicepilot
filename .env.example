# VoicePilot AI — environment template.
# Copy to .env and fill in. NEVER commit a real .env with secrets.
#
# --- Required: database --------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/voicepilot"

# --- Required: encryption ------------------------------------
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Used for AES-256-GCM encryption of provider credentials at rest.
APP_ENCRYPTION_KEY=""

# --- Branding (public) ---------------------------------------
NEXT_PUBLIC_BRAND_NAME="VoicePilot AI"

# --- Optional: real telephony providers ----------------------
# Leave empty to stay in mock/simulated mode (default).
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# DEEPGRAM_API_KEY=""
# VAPI_API_KEY=""
# RETELL_API_KEY=""

# --- Voice bridge (server-to-server) -------------------------
# Shared secret for bridge -> control-plane auth. Generate: openssl rand -hex 32
# Must match BRIDGE_SHARED_SECRET in voicepilot-bridge/.env
# BRIDGE_SHARED_SECRET=""
# Public wss:// URL of the bridge (wss://<bridge-host>/twilio). Empty = mock/fallback mode.
# BRIDGE_PUBLIC_URL=""

# --- Twilio (real telephony; leave empty to stay in mock mode) --
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=<redacted>
